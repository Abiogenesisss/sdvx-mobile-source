                <div class="field original-text summary-difficulty-panel" data-image=""></div>
                <div class="field original-text summary-difficulty-digits"></div>
                <div class="field original-text summary-grade" data-image=""></div>
                <div class="field original-text summary-lamp" data-image=""></div>
            </div>
            <div class="row">
                <div class="field summary-title"></div>
                <div class="field summary-title-auto"></div>
                <div class="field summary-auto"></div>
                <div class="field original-text summary-difficulty-panel" data-image=""></div>
                <div class="field original-text summary-difficulty-digits"></div>
                <div class="field original-text summary-grade" data-image=""></div>
                <div class="field original-text summary-lamp" data-image=""></div>
            </div>
        </div>
        <div id="result-title" class="field original-text" data-baseline="23"></div>

<template name="cabinet-common">
    <head></head>
    <body>
        <div id="notice" class="field"></div>
        <div id="footer-credit" class="field"></div>
        <div id="footer-paseli" class="field"></div>
        <div id="subscreen-back-panel" class="field original-text" data-background="true"></div>
        <div id="subscreen-back-icon" class="field original-text" data-baseline="62"></div>
        <div id="subscreen-back-label" class="field original-text" data-baseline="24"></div>
        <div id="blaster-gauge" class="field original-text">
            <div class="field original-text blaster-rim" data-polygon="13 30 327 30 327 43 317 51 23 51 13 43"></div>
            <div class="field original-text blaster-interior" data-polygon="15 32 325 32 325 42 316 49 24 49 15 42"
                 data-color="0.055 0.035 0.032 1"></div>
            <div class="field original-text blaster-fill" data-fill-width="300">
                <div class="field original-text blaster-fill-shape" data-polygon="15 32 325 32 325 42 316 49 24 49 15 42"
                     data-color="0.85 0.04 0.025 1"></div>
                <div class="field original-text blaster-gloss" data-background="true" data-color="1 0.29 0.19 1"></div>
            </div>
            <div class="field original-text blaster-song-icon" data-image="ex_track/bpass_r_icon.png"></div>
            <div class="field original-text blaster-result-icon" data-image="result_details/bpass_r_icon.png" data-color="1 1 1 0.4"></div>
            <div class="field original-text blaster-caption-shadow" data-baseline="19"></div>
            <div class="field original-text blaster-caption" data-baseline="19"></div>
            <div class="field original-text blaster-effect"></div>
        </div>
    </body>
</template>

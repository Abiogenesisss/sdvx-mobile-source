<template name="cabinet-settings">
    <head></head>
    <body>
        <div id="search-title" class="field"></div>
        <div id="search-artist" class="field"></div>
        <div id="search-charter" class="field"></div>
        <div id="search-illustrator" class="field"></div>
        <div id="search-rows">
            <div class="row">
                <div class="field search-row-title"></div>
                <div class="field search-row-artist"></div>
            </div>
            <div class="row">
                <div class="field search-row-title"></div>
                <div class="field search-row-artist"></div>
            </div>
            <div class="row">
                <div class="field search-row-title"></div>

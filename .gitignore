# Allow only source paths. Local HDD, generated data, credentials and packages stay private.
*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/docs/
!/docs/*.md
!/tools/
!/tools/*.ps1
!/tools/*.sh
!/tools/*.py
!/development/
!/development/android-native/
!/development/android-native/*.gradle
!/development/android-native/gradle.properties
!/development/android-native/tools/
!/development/android-native/tools/*.py
!/development/android-native/src/
!/development/android-native/src/main/
!/development/android-native/src/main/AndroidManifest.xml
!/development/android-native/src/main/cpp/
!/development/android-native/src/main/cpp/CMakeLists.txt
!/development/android-native/src/main/cpp/*.cpp
!/development/android-native/src/main/cpp/*.h
!/development/android-native/src/main/java/
!/development/android-native/src/main/java/local/
!/development/android-native/src/main/java/local/sdvx/
!/development/android-native/src/main/java/local/sdvx/nativeport/
!/development/android-native/src/main/java/local/sdvx/nativeport/*.kt
!/development/android-native/src/main/res/
!/development/android-native/src/main/res/mipmap-anydpi-v26/
!/development/android-native/src/main/res/mipmap-anydpi-v26/ic_launcher.xml
!/development/android-native/src/main/assets/
!/development/android-native/src/main/assets/ui/
!/development/android-native/src/main/assets/ui/*.rml
!/development/android-native/src/main/assets/ui/*.rcss
